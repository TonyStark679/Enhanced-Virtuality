```text
# ============================================================
# E.V. // ENHANCED VIRTUALITY
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
#
# Copy this file to .env and fill in the values you need.
#
# IMPORTANT:
# - Never commit your real .env file.
# - Never put real API keys in this file.
# - Empty values use the defaults built into E.V.
#
# ============================================================


# ============================================================
# CLOUD AI // GEMINI
# ============================================================

# Your Google Gemini API key.
# Required only when using Gemini.
GEMINI_API_KEY=

# Gemini model used by E.V.
GEMINI_MODEL=gemini-2.5-flash


# ============================================================
# E.V. // MODEL SELECTION
# ============================================================

# Available modes:
#
# auto   = Prefer Gemini when available, otherwise use Qwen.
# gemini = Always use Gemini.
# qwen   = Always use local Qwen.
#
JARVIS_MODEL=auto


# ============================================================
# LOCAL AI // QWEN
# ============================================================

# Optional custom Qwen GGUF model path.
#
# Leave empty to use:
# ~/jarvis/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf
#
JARVIS_MODEL_FILE=

# Optional path or command for llama-cli.
#
# Leave empty to automatically search PATH.
#
JARVIS_LLAMA_CLI=

# Number of CPU threads used by the local Qwen engine.
JARVIS_THREADS=4

# Context window.
JARVIS_CTX=2048

# Maximum number of generated tokens.
JARVIS_MAX_TOKENS=256

# Qwen generation temperature.
JARVIS_TEMPERATURE=0.7

# Maximum time allowed for a Qwen generation.
# Value is in seconds.
JARVIS_QWEN_TIMEOUT=180


# ============================================================
# E.V. // PATHS
# ============================================================

# Optional E.V. home directory.
#
# Leave empty to use:
# ~/jarvis
#
JARVIS_HOME=

# Optional custom memory file.
JARVIS_MEMORY_FILE=

# Optional custom personality file.
JARVIS_PERSONALITY_FILE=

# Optional custom E.V. logo file.
JARVIS_LOGO_FILE=


# ============================================================
# NETWORK
# ============================================================

# Timeout used when checking internet connectivity.
# Value is in seconds.
JARVIS_NETWORK_TIMEOUT=3


# ============================================================
# NOTES
# ============================================================
#
# Minimal configuration:
#
# GEMINI_API_KEY=your_key_here
# JARVIS_MODEL=auto
#
# For completely local operation:
#
# JARVIS_MODEL=qwen
#
# E.V. will then use the local Qwen GGUF through llama-cli.
#
# ============================================================
# E.V. // ENHANCED VIRTUALITY
# ============================================================
```
